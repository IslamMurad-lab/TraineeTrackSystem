@model TraineeTrackSystem.ViewModels.TraineeResultViewModel

<div class="d-flex justify-content-center mt-5">
    <div class="card shadow-sm" style="width: 420px; border-radius: 12px;">
        <div class="card-header bg-dark text-white text-center py-3" style="border-radius: 12px 12px 0 0;">
            <h4 class="mb-0">Course Result</h4>
        </div>
        <div class="card-body p-4">
            <div class="mb-3">
                <small class="text-muted">Trainee Name</small>
                <h5 class="mb-0">@Model.TraineeName</h5>
            </div>

            <div class="mb-3">
                <small class="text-muted">Course</small>
                <h5 class="mb-0">@Model.CrsName</h5>
            </div>

            <div class="mb-3">
                <small class="text-muted">Degree</small>
                <h5 class="mb-0">@Model.Degree</h5>
            </div>

            <hr />

            <div class="text-center">
                @if (Model.Passed)
                {
                    <span class="badge bg-success p-2" style="font-size: 16px;">
                        ✔ Passed
                    </span>
                }
                else
                {
                    <span class="badge bg-danger p-2" style="font-size: 16px;">
                        ✘ Failed
                    </span>
                }
            </div>
        </div>
    </div>
</div>