@model TraineeTrackSystem.ViewModels.TraineeAllResultsViewModel

<div class="d-flex justify-content-center mt-5">
    <div style="width: 500px;">
        <h3 class="text-center mb-4">@Model.TraineeName - All Results</h3>

        @if (!Model.Results.Any())
        {
            <p class="text-center text-muted">No results found for this trainee.</p>
        }
        else
        {
            @foreach (var item in Model.Results)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1">@item.CrsName</h5>
                            <small class="text-muted">Degree: @item.Degree</small>
                        </div>
                        <div>
                            @if (item.Passed)
                            {
                                <span class="badge bg-success p-2">✔ Passed</span>
                            }
                            else
                            {
                                <span class="badge bg-danger p-2">✘ Failed</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>